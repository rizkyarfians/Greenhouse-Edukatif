# Local development only. Keep the encoded password in DATABASE_URL in sync.
POSTGRES_PASSWORD=automotion_local
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://automotion:automotion_local@127.0.0.1:5433/automotion
API_HOST=127.0.0.1
API_PORT=3001

# Optional Google login. Use the same callback URL registered in Google Cloud.
# For local testing: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
AUTH_SESSION_SECRET=
