rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function percent(value) {
      return value is number && value >= 0 && value <= 100;
    }

    function validGreenhouse(state) {
      return state.keys().hasOnly(['zone', 'completedZone', 'roofVisible', 'readings', 'zoneMedia'])
        && state.zone in ['A', 'B'] && state.completedZone in [null, 'A', 'B']
        && state.roofVisible is bool
        && state.readings is map && state.readings.keys().hasOnly(['temperature', 'humidity', 'water', 'nutrient'])
        && state.readings.temperature is number && percent(state.readings.humidity)
        && percent(state.readings.water) && percent(state.readings.nutrient)
        && state.zoneMedia is map && state.zoneMedia.keys().hasOnly(['A', 'B'])
        && percent(state.zoneMedia.A) && percent(state.zoneMedia.B);
    }

    function validRice(state) {
      return state.keys().hasOnly(['waterDepth', 'soilMoisture'])
        && state.waterDepth is int && state.waterDepth >= 0 && state.waterDepth <= 5
        && percent(state.soilMoisture);
    }

    function validProject(data) {
      let crop = data.get('cropId', null);
      return data.keys().hasOnly(['name', 'type', 'state', 'cropId', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.type in ['greenhouse', 'rice']
        && data.updatedAt == request.time && data.state is map
        && (!('cropId' in data)
          ? (data.type == 'greenhouse' ? validGreenhouse(data.state) : validRice(data.state))
          : (crop in ['cabbage', 'chili', 'cucumber'] || (crop == 'maize' && data.type == 'rice'))
            && data.state.size() == 0);
    }

    match /automotionAccounts/{uid}/simulations/{simulationId} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid) && simulationId.matches('^[a-f0-9]{32}$')
        && validProject(request.resource.data);
    }
  }
}
